[Unit]
Description=VibeFactory Native Android APK Builder Canary
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/vibefactory-native/flutter_apk_server
EnvironmentFile=/etc/vibefactory-native/server.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
Environment=ANDROID_HOME=/opt/android-sdk
ExecStart=/opt/vibefactory-native/flutter_apk_server/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
