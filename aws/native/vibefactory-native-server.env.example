BASE_PROJECT_PATH=/opt/vibefactory-native/BaseProject
WORKSPACES_ROOT=/srv/vibefactory-native/native_workspaces
DB_PATH=/srv/vibefactory-native/native_tasks.db
APP_DATA_DB_PATH=/srv/vibefactory-native/native_app_data.db
BUILD_CACHE_ROOT=/srv/vibefactory-native/.native_tooling
SERVER_BASE_URL=http://EC2_PUBLIC_HOST:8081

CODEX_TIMEOUT_SECONDS=1800
MAX_CONCURRENT_CODEX_RUNS=1
CODEX_DANGEROUS_BYPASS=0
CODEX_SANDBOX_MODE=workspace-write
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=default
CODEX_SERVICE_TIER=default
CODEX_FAST_MODE=0

# Keep canary boot in mock mode until the health and API contract tests pass.
MOCK_CODEX=1
INTENT_AGENT_ENABLED=0
INTENT_AGENT_MODEL=gpt-5.4
INTENT_AGENT_TIMEOUT_SECONDS=20
CODEX_EXISTING_TASK_FOLLOWUP_ENABLED=1
CODEX_FOLLOWUP_DECISION_TIMEOUT_SECONDS=90
CODEX_FOLLOWUP_REASONING_EFFORT=low

OPENAI_API_KEY=
APP_RUNTIME_OPENAI_API_KEY=
APP_RUNTIME_MODEL=gpt-5.4-mini
APP_RUNTIME_DAILY_REQUEST_LIMIT=100
APP_RUNTIME_DAILY_TOKEN_LIMIT=50000
APP_RUNTIME_MAX_OUTPUT_TOKENS=0

GENERATED_APP_KEYSTORE_PATH=/etc/vibefactory-native/secrets/generated-app.jks
GENERATED_APP_KEYSTORE_PASSWORD=
GENERATED_APP_KEY_ALIAS=vibefactory-generated
GENERATED_APP_KEY_PASSWORD=

ADMIN_API_TOKEN=
