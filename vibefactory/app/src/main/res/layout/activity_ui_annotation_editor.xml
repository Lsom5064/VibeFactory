<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/uiAnnotationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnBackUiAnnotation"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ui_editor_back"
                android:src="@drawable/ic_triangle_back"
                app:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/uiAnnotationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/uiAnnotationRevision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUiAnnotationScreen"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_secondary"
                android:maxWidth="128dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/ui_editor_screen"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/uiAnnotationWorkspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bg_panel_alt">

            <HorizontalScrollView
                android:id="@+id/uiAnnotationHorizontalViewport"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="92dp">

                <ScrollView
                    android:id="@+id/uiAnnotationVerticalViewport"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fillViewport="false">

                    <FrameLayout
                        android:id="@+id/uiAnnotationCanvas"
                        android:layout_width="360dp"
                        android:layout_height="wrap_content"
                        android:minHeight="640dp"
                        android:background="#FFFFFFFF"
                        android:padding="1dp" />
                </ScrollView>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/uiAnnotationStateOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg_panel_alt"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/uiAnnotationProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

                <TextView
                    android:id="@+id/uiAnnotationStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/ui_editor_loading_layouts"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnUiAnnotationRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/ui_editor_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/uiAnnotationInstructionBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_ui_editor_section"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/uiAnnotationInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnCancelUiAnnotationAction"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ui_annotation_cancel_action"
                    android:src="@drawable/ic_annotation_delete" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/uiAnnotationFloatingToolbar"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="14dp"
                android:background="@drawable/bg_ui_annotation_toolbar"
                android:elevation="12dp"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnUiAnnotationToolbarHandle"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_move_toolbar"
                        android:src="@drawable/ic_annotation_drag_handle" />

                    <LinearLayout
                        android:id="@+id/uiAnnotationToolGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnUiAnnotationDeleteTool"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_delete_tool"
                        android:src="@drawable/ic_annotation_delete" />

                    <ImageButton
                        android:id="@+id/btnUiAnnotationMoveTool"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_move_tool"
                        android:src="@drawable/ic_annotation_move" />

                    <ImageButton
                        android:id="@+id/btnUiAnnotationBehaviorTool"
                        android:layout_width="44dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_behavior_tool"
                        android:src="@drawable/ic_annotation_behavior" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@color/divider_soft" />

                    <ImageButton
                        android:id="@+id/btnUiAnnotationList"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_list"
                        android:src="@drawable/ic_annotation_list" />

                    <ImageButton
                        android:id="@+id/btnUiAnnotationClear"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_clear"
                        android:src="@drawable/ic_annotation_clear" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnUiAnnotationCollapse"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_annotation_collapse_toolbar"
                        android:src="@drawable/ic_annotation_collapse" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/uiAnnotationCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_annotation_empty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnUiAnnotationUndo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ui_editor_undo"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnUiAnnotationRedo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ui_editor_redo"
                android:rotationY="180"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary" />

            <Button
                android:id="@+id/btnUiAnnotationSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_send_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/ui_editor_save"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
