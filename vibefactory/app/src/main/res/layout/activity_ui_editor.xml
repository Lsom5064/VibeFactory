<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/uiEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackUiEditor"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_top_chip"
            android:contentDescription="@string/navigate_back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_settings" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/uiEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ui_editor_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiEditorRevision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/uiEditorPaletteSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ui_editor_section"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/uiEditorPaletteSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_editor_palette_section_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiEditorPaletteSectionSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/ui_editor_palette_close"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/uiEditorPaletteChevron"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/ui_editor_collapse_palette"
                android:padding="7dp"
                android:rotation="90"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uiEditorPaletteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/uiEditorActionToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnUiEditorScreen"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_button_secondary"
                        android:minWidth="140dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/ui_editor_screen"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorUndo"
                        android:layout_width="48dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_secondary"
                        android:contentDescription="@string/ui_editor_undo"
                        android:minWidth="0dp"
                        android:text="↶"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp" />

                    <Button
                        android:id="@+id/btnUiEditorRedo"
                        android:layout_width="48dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:contentDescription="@string/ui_editor_redo"
                        android:minWidth="0dp"
                        android:text="↷"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp" />

                    <Button
                        android:id="@+id/btnUiEditorSave"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_send_button"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/ui_editor_save"
                        android:textAllCaps="false"
                        android:textColor="@color/text_inverse" />

                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/ui_editor_elements_label"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/uiEditorPaletteToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <Button
                    android:id="@+id/btnUiEditorLayers"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ui_editor_layers"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnUiAddElement"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_send_button"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ui_editor_add_element"
                    android:textAllCaps="false"
                    android:textColor="@color/text_inverse" />

                <Button
                    android:id="@+id/btnUiAddText"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_text"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddButton"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_button"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddInput"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_input"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddImage"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_image"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddIcon"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_icon"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddCard"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_card"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnUiAddList"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/ui_editor_add_list"
                    android:textAllCaps="false" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/uiEditorCanvasSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ui_editor_section"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_editor_canvas_section_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiEditorCanvasMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/uiEditorInteractionMode"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUiEditorScrollMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_send_button"
                android:minWidth="0dp"
                android:text="@string/ui_editor_scroll_mode"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse" />

            <Button
                android:id="@+id/btnUiEditorMoveMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="0dp"
                android:text="@string/ui_editor_move_mode"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/uiEditorCanvasContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_editor_canvas">

            <HorizontalScrollView
                android:id="@+id/uiEditorCanvasViewport"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="false">

                <ScrollView
                    android:id="@+id/uiEditorCanvasVerticalViewport"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fillViewport="false">

                    <FrameLayout
                        android:id="@+id/uiEditorCanvas"
                        android:layout_width="360dp"
                        android:layout_height="wrap_content"
                        android:minHeight="640dp"
                        android:background="#FFFFFFFF"
                        android:padding="1dp" />
                </ScrollView>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/uiEditorStateOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ProgressBar
                    android:id="@+id/uiEditorProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp" />

                <TextView
                    android:id="@+id/uiEditorStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/ui_editor_loading_layouts"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnUiEditorRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="@string/ui_editor_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/uiEditorPropertiesPanel"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_ui_editor_section"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/uiEditorPropertiesResizeHandle"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="@string/ui_editor_resize_properties"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ui_editor_resize_handle"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/uiEditorPropertiesScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/uiEditorSelectedElement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUiEditorCloseProperties"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ui_editor_close_properties"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/uiEditorElementTextContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ui_editor_property_text"
                app:boxBackgroundColor="@color/bg_panel_alt"
                app:boxBackgroundMode="filled"
                app:boxStrokeColor="@color/accent_primary"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/uiEditorElementText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uiEditorWidthContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ui_editor_property_width"
                    app:boxBackgroundColor="@color/bg_panel_alt"
                    app:boxBackgroundMode="filled"
                    app:boxStrokeColor="@color/accent_primary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uiEditorWidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uiEditorHeightContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/ui_editor_property_height"
                    app:boxBackgroundColor="@color/bg_panel_alt"
                    app:boxBackgroundMode="filled"
                    app:boxStrokeColor="@color/accent_primary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uiEditorHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uiEditorMarginStartContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/ui_editor_property_x"
                    app:boxBackgroundColor="@color/bg_panel_alt"
                    app:boxBackgroundMode="filled"
                    app:boxStrokeColor="@color/accent_primary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uiEditorMarginStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/uiEditorMarginTopContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:hint="@string/ui_editor_property_y"
                    app:boxBackgroundColor="@color/bg_panel_alt"
                    app:boxBackgroundMode="filled"
                    app:boxStrokeColor="@color/accent_primary"
                    app:hintTextColor="@color/text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/uiEditorMarginTop"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/uiEditorTextColorControl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:clickable="true"
                    android:contentDescription="@string/ui_editor_choose_text_color"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_editor_property_text_color"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/uiEditorTextColorSwatch"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_color_swatch_empty"
                            android:importantForAccessibility="no" />

                        <EditText
                            android:id="@+id/uiEditorTextColor"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:clickable="false"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="@string/ui_editor_property_text_color"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/uiEditorBackgroundControl"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:clickable="true"
                    android:contentDescription="@string/ui_editor_choose_background_color"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_editor_property_background"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/uiEditorBackgroundSwatch"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_color_swatch_empty"
                            android:importantForAccessibility="no" />

                        <EditText
                            android:id="@+id/uiEditorBackground"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:clickable="false"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="@string/ui_editor_property_background"
                            android:padding="0dp"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ui_editor_property_description"
                app:boxBackgroundColor="@color/bg_panel_alt"
                app:boxBackgroundMode="filled"
                app:boxStrokeColor="@color/accent_primary"
                app:hintTextColor="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/uiEditorDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:minHeight="72dp"
                    android:minLines="2"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnUiEditorApply"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_send_button"
                        android:text="@string/ui_editor_apply"
                        android:textAllCaps="false"
                        android:textColor="@color/text_inverse" />

                    <Button
                        android:id="@+id/btnUiEditorAttachImage"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_attach_image"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnUiEditorChooseIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_choose_icon"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnUiEditorDuplicate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_duplicate"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorLayerBack"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_layer_back"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorLayerFront"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_layer_front"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_delete"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
