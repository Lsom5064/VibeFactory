<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/uiEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackUiEditor"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_top_chip"
            android:contentDescription="@string/navigate_back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_settings" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/uiEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ui_editor_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/uiEditorRevision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/uiEditorActionToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUiEditorScreen"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_secondary"
                android:minWidth="140dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/ui_editor_screen"
                android:textAllCaps="false"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnUiEditorUndo"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="@string/ui_editor_undo"
                android:minWidth="0dp"
                android:text="↶"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnUiEditorRedo"
                android:layout_width="48dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button_secondary"
                android:contentDescription="@string/ui_editor_redo"
                android:minWidth="0dp"
                android:text="↷"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="19sp" />

            <Button
                android:id="@+id/btnUiEditorSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_send_button"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/ui_editor_save"
                android:textAllCaps="false"
                android:textColor="@color/text_inverse" />

        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnUiEditorSubmit"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_send_button"
        android:minWidth="0dp"
        android:text="@string/ui_editor_submit"
        android:textAllCaps="false"
        android:textColor="@color/text_inverse" />

    <TextView
        android:id="@+id/uiEditorCanvasMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:id="@+id/uiEditorPaletteToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUiEditorLayers"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/ui_editor_layers"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddElement"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_element"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddText"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_text"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddButton"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_button"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddInput"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_input"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddImage"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_image"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddCard"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_card"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnUiAddList"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/ui_editor_add_list"
                android:textAllCaps="false" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/uiEditorCanvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_surface_alt">

        <HorizontalScrollView
            android:id="@+id/uiEditorCanvasViewport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false">

            <ScrollView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:fillViewport="false">

                <FrameLayout
                    android:id="@+id/uiEditorCanvas"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:minHeight="640dp"
                    android:background="#FFFFFFFF"
                    android:padding="1dp" />
            </ScrollView>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/uiEditorProgress"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/uiEditorStateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/ui_editor_loading_layouts"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnUiEditorRetry"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/ui_editor_retry"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/uiEditorPropertiesPanel"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_surface_card"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/uiEditorSelectedElement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUiEditorDoneEditing"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_button_secondary"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/ui_editor_done_editing"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <EditText
                android:id="@+id/uiEditorElementText"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_surface_alt"
                android:hint="@string/ui_editor_property_text"
                android:imeOptions="actionNext"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/uiEditorWidth"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_width"
                    android:imeOptions="actionNext"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <EditText
                    android:id="@+id/uiEditorHeight"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_height"
                    android:imeOptions="actionNext"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <EditText
                    android:id="@+id/uiEditorMarginStart"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_x"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <EditText
                    android:id="@+id/uiEditorMarginTop"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_y"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/uiEditorTextColor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_text_color"
                    android:imeOptions="actionNext"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <EditText
                    android:id="@+id/uiEditorBackground"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_surface_alt"
                    android:hint="@string/ui_editor_property_background"
                    android:imeOptions="actionNext"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <EditText
                android:id="@+id/uiEditorDescription"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_surface_alt"
                android:gravity="top|start"
                android:hint="@string/ui_editor_property_description"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnUiEditorApply"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_send_button"
                        android:text="@string/ui_editor_apply"
                        android:textAllCaps="false"
                        android:textColor="@color/text_inverse" />

                    <Button
                        android:id="@+id/btnUiEditorAttachImage"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_attach_image"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnUiEditorDuplicate"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_duplicate"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorLayerBack"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_layer_back"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorLayerFront"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_layer_front"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />

                    <Button
                        android:id="@+id/btnUiEditorDelete"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_secondary"
                        android:text="@string/ui_editor_delete"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
